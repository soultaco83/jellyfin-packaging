diff --git a/docker/Dockerfile b/docker/Dockerfile
index e1f2a3b..c4d5e6f 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -8,6 +8,9 @@ ARG OS_VERSION=trixie
 # Jellyfin FFMPEG package
 ARG FFMPEG_PACKAGE=jellyfin-ffmpeg8
 
+# PostgreSQL support (default: false, set to true to build with Pgsql plugin)
+ARG POSTGRES_ENABLED=false
+
 # https://github.com/intel/vpl-gpu-rt/releases
 ARG VPL_GPU_RT_VER=intel-onevpl-25.3.4
 
@@ -136,6 +139,40 @@ RUN dotnet publish \
     --configuration Release \
     --output /plugin-output
 
+#
+# Build the Pgsql (PostgreSQL) database plugin
+#
+FROM debian:${OS_VERSION}-slim AS pgsql-plugin
+
+ARG DOTNET_ARCH
+ARG DOTNET_VERSION
+ARG POSTGRES_ENABLED
+
+ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
+
+RUN if [ "${POSTGRES_ENABLED}" = "true" ]; then \
+    apt-get update \
+ && apt-get install --no-install-recommends --no-install-suggests --yes \
+    curl \
+    ca-certificates \
+    libicu76 \
+ && curl -fsSL https://dot.net/v1/dotnet-install.sh | bash /dev/stdin --channel ${DOTNET_VERSION} --install-dir /usr/local/bin; \
+    fi
+
+# Set up directory structure for the Pgsql plugin ProjectReferences
+WORKDIR /repos
+COPY jellyfin-server jellyfin-server-unstable
+COPY jellyfin-plugin-pgsql jellyfin-plugin-pgsql
+
+RUN if [ "${POSTGRES_ENABLED}" = "true" ]; then \
+    dotnet publish \
+    jellyfin-plugin-pgsql/src/Jellyfin.Pgsql/Jellyfin.Pgsql.csproj \
+    --configuration Release \
+    --output /pgsql-output; \
+    else \
+    mkdir -p /pgsql-output; \
+    fi
+
 #
 # Build the final combined image
 #
@@ -151,6 +188,9 @@ ARG NEO_VER
 ARG IGC1_LEGACY_VER
 ARG NEO_LEGACY_VER
 
+ARG POSTGRES_ENABLED
+ENV POSTGRES_ENABLED=${POSTGRES_ENABLED}
+
 ARG MALI_PKG_VER
 ARG MALI_PKG_TAG
 ARG MALI_PKG_CFG
@@ -214,6 +254,9 @@ RUN apt-get update \
     libdrm2 \
     libjemalloc2 \
     sqlite3 \
+ && if [ "${POSTGRES_ENABLED}" = "true" ]; then \
+    apt-get install --no-install-recommends --no-install-suggests --yes libpq5; \
+    fi \
  && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && locale-gen \
  && apt-get remove gnupg apt-transport-https --yes \
  && apt-get clean autoclean --yes \
@@ -323,6 +366,14 @@ RUN mkdir -p ${JELLYFIN_DATA_DIR} ${JELLYFIN_CACHE_DIR} \
 COPY --from=server /server /jellyfin
 COPY --from=web /web /jellyfin/jellyfin-web
 
+# Install Pgsql plugin (conditionally at build time)
+COPY --from=pgsql-plugin /pgsql-output/ /tmp/pgsql-output/
+RUN if [ "${POSTGRES_ENABLED}" = "true" ]; then \
+    mkdir -p /jellyfin/plugins/Jellyfin.Pgsql \
+ && cp /tmp/pgsql-output/*.dll /jellyfin/plugins/Jellyfin.Pgsql/ 2>/dev/null || true; \
+    fi \
+ && rm -rf /tmp/pgsql-output
+
 RUN chmod 777 -R ${JELLYFIN_WEB_DIR}
 
 # Install FileTransformation plugin (built from source for 10.12 compatibility)